    "/BLX_joint3",
    "/BLX_joint4",
    "/BLX_joint5",
    "/BLX_joint6",
    "/BLX_tool_suction",
    "/RobotBasics",
    "/RobotBasics/Workspace",
    "/RobotBasics/Camera",
    "/RobotBasics/TeachPoints/TeachPoint1",
    "/RobotBasics/TeachPoints/TeachPoint2",
    "/RobotBasics/TeachPoints/TeachPoint3",
    "/RobotBasics/TeachPoints/TeachPoint4"
  ]
}
